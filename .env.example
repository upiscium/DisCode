# Optional separate secret file. OCB_SECRETS_FILE itself must come from the
# real process/systemd environment (or the NixOS module's secretsFile option),
# because the secret file is loaded before this repository-local .env.
# Examples: ~/secrets/ocb_secrets.env, /run/secrets/opencode-discord-bridge.env
# OCB_SECRETS_FILE=~/secrets/ocb_secrets.env

# Logging. Manual runtime defaults to info/pretty for readability; the NixOS
# service module defaults to info/json for journald ingestion.
OCB_LOG_LEVEL=info
OCB_LOG_FORMAT=pretty

# Optional Prometheus/OpenMetrics scrape endpoint. Disabled by default. Loopback
# is the safe default when enabled; exposing another address is an explicit
# operator decision and this application does not add auth/TLS or open firewalls.
OCB_METRICS_ENABLED=false
OCB_METRICS_HOST=127.0.0.1
OCB_METRICS_PORT=9464

# Discord application (dedicated bot application recommended)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_PARENT_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=123456789012345678
DISCORD_ALLOW_PERMISSION_ALWAYS=false
DISCORD_STREAM_ASSISTANT_TEXT=false
DISCORD_SHOW_TOOL_SUMMARIES=false

# OpenCode legacy single-host configuration. This remains the fallback when
# OPENCODE_HOSTS_JSON is unset. Keep the server loopback-only unless you
# deliberately add a secure transport.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Comma-separated absolute repository roots for the legacy/default host.
# Requested directories are resolved to canonical paths and must remain inside
# one of these roots.
OPENCODE_ALLOWED_ROOTS=/home/upiscium/Documents/Programs

# Phase 3 multi-host registry (optional). Host IDs are operator-configured stable
# names; Discord never supplies arbitrary URLs. passwordEnv points at another
# environment variable so credentials are not embedded in the registry JSON.
# Every configured host gets its own OpenCode gateway/SSE consumer, and
# `/oc start host:<id>` selects among these entries. Omitting host uses defaultHost.
# OPENCODE_HOST_LOCAL_PASSWORD=<long-random-password>
# OPENCODE_HOST_LAB_PASSWORD=<long-random-password>
# OPENCODE_HOSTS_JSON={"defaultHost":"local","hosts":[{"id":"local","baseUrl":"http://127.0.0.1:4096","username":"opencode","passwordEnv":"OPENCODE_HOST_LOCAL_PASSWORD","allowedRoots":["/home/upiscium/Documents/Programs"]},{"id":"lab","baseUrl":"http://10.0.0.20:4096","username":"opencode","passwordEnv":"OPENCODE_HOST_LAB_PASSWORD","allowedRoots":["/srv/projects"]}]}

# tmux helper defaults. These helpers manage the local OpenCode server only;
# remote-host tmux/service orchestration is intentionally not performed by Discord.
OPENCODE_TMUX_SOCKET=opencode-bridge
OPENCODE_TMUX_SESSION=opencode
OPENCODE_TMUX_HOSTNAME=127.0.0.1
OPENCODE_TMUX_PORT=4096

# Persistent thread <-> OpenCode session bindings. Secrets are never stored here.
STATE_FILE=.data/state.json
