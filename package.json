{
  "name": "opencode-discord-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "A Discord control surface for OpenCode sessions running on a dedicated host.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.20",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
